# Puerto local donde escucha el worker (Tailscale Funnel lo expone al publico).
PORT=3100

# Opcional: si se define, /send y /unlink exigen: Authorization: Bearer <WA_SECRET>
# Debe coincidir con el "Token del worker" que se guarda en Ajustes de la app.
WA_SECRET=

# Opcional: directorio de sesion de WhatsApp (por defecto ./data/wa).
# WA_SESSION_DIR=./data/wa