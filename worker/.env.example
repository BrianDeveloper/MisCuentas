# Puerto en el que escucha el worker (Render lo inyecta via la variable PORT).
PORT=3100

# Opcional: si se define, /send y /unlink exigen: Authorization: Bearer <WA_SECRET>
# Debe coincidir con el "Token del worker" que se guarda en Ajustes de la app.
WA_SECRET=

# Obligatorias SOLO para respaldar la sesion de WhatsApp en Supabase Storage
# (necesario en Render, cuyo disco es efimero). En local pueden dejarse vacias.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nombre del bucket de Storage para la sesion (por defecto "wa").
# WA_SESSION_BUCKET=wa

# Directorio local de la sesion de WhatsApp (por defecto ./data/wa).
# WA_SESSION_DIR=./data/wa